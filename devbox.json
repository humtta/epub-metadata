{
  "$schema": "https://raw.githubusercontent.com/jetify-com/devbox/0.18.4/.schema/devbox.schema.json",

  "shell": {
    "init_hook": ["uv sync --all-groups"],

    "scripts": {
      "format": "uv run ruff format .",
      "lint": "uv run ruff check .",
      "check": "devbox run format && devbox run lint",

      "dev": "uv run epub-metadata ${@}"
    }
  },

  "packages": {
    "python": {
      "version": "3.14.7",
      "disable_plugin": true
    },
    "uv": "0.12.17"
  }
}
